{
  "name": "web-ide-core",
  "version": "0.1.0",
  "description": "Backend-agnostic browser IDE workbench core with Monaco editor, xterm.js terminal, workspace persistence, and optional WASI runtime adapters",
  "type": "module",
  "license": "MIT",
  "files": [
    "src/",
    "SPEC.md",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./editor": "./src/editor/editor.js",
    "./editor/monaco-setup": "./src/editor/monaco-setup.js",
    "./editor/tabs": "./src/editor/tabs.js",
    "./terminal": "./src/terminal/terminal.js",
    "./terminal/boot-progress": "./src/terminal/boot-progress.js",
    "./ui": "./src/ui/filetree.js",
    "./ui/filetree": "./src/ui/filetree.js",
    "./ui/toast": "./src/ui/toast.js",
    "./layout": "./src/layout/layout.js",
    "./workspace": "./src/workspace/storage.js",
    "./workspace/archive": "./src/workspace/archive.js",
    "./style.css": "./src/style.css",
    "./wasi": "./src/wasi/index.js",
    "./wasi/cache": "./src/wasi/wasm-cache.js",
    "./wasi/runtime": "./src/wasi/runtime.js",
    "./wasi/shell-worker": "./src/wasi/shell-worker.js",
    "./wasi/runtime-worker": "./src/wasi/runtime-worker.js"
  },
  "scripts": {
    "test": "node --import ./test/setup-loader.mjs --test test/*.test.js",
    "pack:tgz": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "ansi-line-editor": "https://github.com/breeze833/ansi-line-editor/releases/download/latest/ansi-line-editor-0.1.0.tgz",
    "busybox-wasi": "https://github.com/breeze833/busybox-wasi/releases/download/v1.38.0-build1/busybox-wasi-1.38.0-build1.tgz",
    "canvas-wasi": "https://github.com/breeze833/canvas-wasi/releases/download/v0.1.4/canvas-wasi-0.1.4.tgz",
    "stdin-wasi": "https://github.com/breeze833/stdin-wasi/releases/download/v0.1.0/stdin-wasi-0.1.0.tgz",
    "vfs-wasi": "https://github.com/breeze833/vfs-wasi/releases/download/v0.2.0/vfs-wasi-0.2.0.tgz",
    "wasi-host": "https://github.com/breeze833/wasi-host/releases/download/v0.1.1/wasi-host-0.1.1.tgz"
  },
  "overrides": {
    "wasi-host": "https://github.com/breeze833/wasi-host/releases/download/v0.1.1/wasi-host-0.1.1.tgz"
  },
  "peerDependencies": {
    "ansi-line-editor": "*",
    "busybox-wasi": ">=1.38.0-build1",
    "canvas-wasi": "*",
    "stdin-wasi": "*",
    "vfs-wasi": ">=0.2.0",
    "wasi-host": ">=0.1.1"
  },
  "peerDependenciesMeta": {
    "ansi-line-editor": {
      "optional": true
    },
    "busybox-wasi": {
      "optional": true
    },
    "canvas-wasi": {
      "optional": true
    },
    "stdin-wasi": {
      "optional": true
    },
    "vfs-wasi": {
      "optional": true
    },
    "wasi-host": {
      "optional": true
    }
  }
}
